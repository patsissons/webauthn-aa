# =============================================================================
# Committed, non-secret defaults shared across both apps for local development.
# Secrets and machine-specific overrides go in .env.local (gitignored).
# =============================================================================

# ----- Relying Party (RP) -----
RP_ID=localhost
RP_NAME=Demo RP
RP_ORIGIN=http://localhost:3000

# RP -> AA brokering
ATTESTATION_API_BASE_URL=http://localhost:3001
ATTESTATION_PROTOCOL_VERSION=1
ATTESTATION_REQUESTED_ATTRIBUTES=name,age
ATTESTATION_AWAIT_TIMEOUT_MS=25000
ATTESTATION_TOTAL_BUDGET_MS=180000
ATTESTATION_FAIL_MODE=closed

# Region resolution: static | location | demo
REGION_RESOLVER=demo
RP_REGION=region-1
REGIONS_CONFIG_PATH=./config/regions.json

# RP PocketBase instance
POCKETBASE_RP_URL=http://127.0.0.1:8090

# AA origin the BROWSER calls directly to fetch the genuine encryption public key
# (out of the RP's hands, to prevent RP key-substitution MITM). Compiled into the
# client bundle as honest client config — not a per-request value the RP can swap.
NEXT_PUBLIC_AA_ORIGIN=http://localhost:3001

# RP web origin the AA capture page is allowed to postMessage ciphertext back to.
# Evidence is captured + encrypted on the AA origin (a popup the RP can't script
# into); only the RP origin below may receive the resulting envelope.
NEXT_PUBLIC_RP_ORIGIN=http://localhost:3000

# ----- Attestation Authority (AA) -----
AA_ORIGIN=http://localhost:3001
AA_ENCRYPTION_MATERIAL_TTL_MS=300000
AA_AWAIT_MAX_WAIT_MS=25000
AA_DATA_TTL_MS=31536000000
AA_WEBHOOK_MAX_ATTEMPTS=8
AA_WEBHOOK_BASE_DELAY_MS=1000

# AA PocketBase instance
POCKETBASE_AA_URL=http://127.0.0.1:8091

# Where the AA delivers revocation webhooks for this RP client
RP_WEBHOOK_URL=http://localhost:3000/api/webhooks/attestation
